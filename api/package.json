{
  "name": "7k-note-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute 7k-note --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute 7k-note --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.137.0"
  }
}
