{
  "name": "7k-note-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute 7k-note --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute 7k-note --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "seed:pandoara": "node ../scripts/seed-pandoara.mjs && wrangler d1 execute 7k-note --local --file=seed-pandoara.sql",
    "db:migrate": "wrangler d1 migrations apply 7k-note --local",
    "db:migrate:remote": "wrangler d1 migrations apply 7k-note --remote",
    "pandoara:heronotes": "node ../scripts/seed-pandoara.mjs && wrangler d1 execute 7k-note --local --file=upgrade-pandoara-heronotes.sql",
    "test": "node tests/audit.mjs && node tests/owner.mjs && node tests/limits.mjs && node tests/autotext-api.mjs && node tests/cron.mjs && node tests/cron-autotext.mjs && node tests/view-lock.mjs"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.137.0"
  }
}
